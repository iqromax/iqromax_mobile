datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  customId  String   @unique // Like #0012
  role      String   @default("Student")
  name      String
  phone     String
  email     String   @unique
  password  String
  country   String?
  language  String?
  character String?
  status    String   @default("Faol")
  energy    Int      @default(10)
  xp        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // The user receiving the notification
  senderId  String?  // The user sending the notification (optional if system)
  type      String   // "BATTLE_INVITE", etc.
  title     String?  // The title of the notification (optional)
  message   String?
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, IGNORED
  createdAt DateTime @default(now())
}

model Referral {
  id         String   @id @default(uuid())
  referrerId String
  referredId String   @unique
  status     String   @default("WAITING") // "WAITING" or "ACTIVE"
  createdAt  DateTime @default(now())
}

model Mission {
  id        String   @id @default(uuid())
  type      String   // "VIDEO_UPLOAD", "YOUTUBE", "TELEGRAM", "INSTAGRAM"
  title     String
  link      String?  // Youtube, Telegram, Instagram linki
  fileUrl   String?  // Upload qilingan video linki
  reward    Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserMission {
  id          String   @id @default(uuid())
  userId      String   // Custom ID of the user (e.g. #0012)
  missionId   String
  completedAt DateTime @default(now())

  @@unique([userId, missionId])
}

model TeacherRequest {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  password  String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MysteryBoxItem {
  id          String   @id @default(uuid())
  name        String
  description String
  badge       String?  // Optional badge tag e.g. "⚡ 3 kun", "⚡ +5 Energiya"
  type        String   @default("premium") // "premium" (kunlar), "energy" (1-10 chaqmoq)
  value       Int      @default(1) // Value: Days for premium, 1-10 count for energy
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
