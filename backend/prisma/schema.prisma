datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  customId  String   @unique // Like #0012
  role      String   @default("Student")
  name      String
  phone     String
  email     String   @unique
  password  String
  country   String?
  language  String?
  character String?
  status    String   @default("Faol")
  energy    Int      @default(10)
  xp               Int       @default(0)
  coin             Int       @default(0)
  premiumExpiresAt DateTime? // Timestamp when won Premium subscription expires
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // The user receiving the notification
  senderId  String?  // The user sending the notification (optional if system)
  type      String   // "BATTLE_INVITE", etc.
  title     String?  // The title of the notification (optional)
  message   String?
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, IGNORED
  createdAt DateTime @default(now())
}

model Referral {
  id         String   @id @default(uuid())
  referrerId String
  referredId String   @unique
  status     String   @default("WAITING") // "WAITING" or "ACTIVE"
  createdAt  DateTime @default(now())
}

model Mission {
  id        String   @id @default(uuid())
  type      String   // "VIDEO_UPLOAD", "YOUTUBE", "TELEGRAM", "INSTAGRAM"
  title     String
  link      String?  // Youtube, Telegram, Instagram linki
  fileUrl   String?  // Upload qilingan video linki
  reward    Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserMission {
  id          String   @id @default(uuid())
  userId      String   // Custom ID of the user (e.g. #0012)
  missionId   String
  completedAt DateTime @default(now())

  @@unique([userId, missionId])
}

model TeacherRequest {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  password  String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MysteryBoxItem {
  id          String   @id @default(uuid())
  name        String
  description String
  badge       String?  // Optional badge tag e.g. "⚡ 3 kun", "⚡ +5 Energiya"
  type        String   @default("premium") // "premium" (kunlar), "energy" (1-10 chaqmoq)
  value       Int      @default(1) // Value: Days for premium, 1-10 count for energy
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventorySkin {
  id          String   @id @default(uuid())
  category    String   // "bosh_kiyim", "ustki_kiyim", "shim", "oyoq_kiyim", "aksessuar", "ryukzak"
  name        String
  rarity      String   @default("ODDIY") // "ODDIY", "RARE", "EPIC", "LEGENDARY"
  imageUrl    String?  // skin preview image URL
  modelUrl    String?  // .glb 3D model URL
  price       Int      @default(0) // Coin price
  targetGender String? @default("all") // "all", "boys", "girls"
  isLocked    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopItem {
  id          String   @id @default(uuid())
  category    String   // "inventory", "energy", "mystery"
  subcategory String?  // "top", "pants", "shoes", "accessories", "backpacks" for inventory
  name        String
  description String?
  imageUrl    String?  // uploaded image URL or static asset identifier
  modelUrl    String?  // uploaded 3D .glb model file URL
  value       Int      @default(1) // energy count or key count
  price       Int      // Coin price e.g. 50
  targetGender String? @default("all") // "all", "boys", "girls"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserPurchase {
  id        String   @id @default(uuid())
  userId    String   // customId of User
  itemId    String   // id of the purchased skin
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String   // customId of the sender
  receiverId String   // customId of the receiver
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Friend {
  id        String   @id @default(uuid())
  userId1   String   // customId (alphabetically smaller one, for uniqueness)
  userId2   String   // customId (alphabetically larger one)
  createdAt DateTime @default(now())

  @@unique([userId1, userId2])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   // customId of the sender
  receiverId String   // customId of the receiver
  content    String
  isRead     Boolean  @default(false)
  deletedBy  String[] @default([]) // Array of customIds who deleted this message
  createdAt  DateTime @default(now())
}

// =======================
// TEACHER TRAINING COURSE
// =======================

model CourseModule {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos    CourseVideo[]
  tests     CourseTest[]
  guides    CourseGuide[]
}

model CourseVideo {
  id          String   @id @default(uuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    String?
  order       Int      @default(0)
  videoUrl    String?
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseTest {
  id        String   @id @default(uuid())
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  duration  String?
  order     Int      @default(0)
  
  testType        String   @default("theory") // "theory" or "practical"
  practicalOp     String?  // e.g. "Oddiy", "Formula 5", "Formula 10", "Aralash"
  practicalDigits String?  // e.g. "1", "2"
  practicalCount  Int?     // e.g. 10

  questions CourseTestQuestion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseGuide {
  id        String   @id @default(uuid())
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  content   String?  // Rich text HTML
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseTestQuestion {
  id        String   @id @default(uuid())
  testId    String
  test      CourseTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  text      String
  options   CourseTestOption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseTestOption {
  id         String   @id @default(uuid())
  questionId String
  question   CourseTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CourseExam {
  id        String   @id @default(uuid())
  title     String
  duration  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseGraduate {
  id        String   @id @default(uuid())
  userId    String   // customId of the user
  name      String
  score     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
